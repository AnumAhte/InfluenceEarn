# Supabase project (Project Settings → API). The publishable/anon key is browser-safe;
# data access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key

# Absolute origin used in auth emails (confirmation + password reset links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets (never prefix with NEXT_PUBLIC_). Not needed in phase 1.
# SUPABASE_SERVICE_ROLE_KEY=
