# Supabase project (Project Settings → API). The publishable/anon key is browser-safe;
# data access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key

# Absolute origin used in auth emails (confirmation + password reset links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server-only secrets (never prefix with NEXT_PUBLIC_) ─────────────────────────────
# Secret (service-role) key, used only by the notification email worker. Local: printed by `supabase start`.
SUPABASE_SECRET_KEY=

# Notification emails over SMTP. Local: Mailpit (no auth). Production: any SMTP provider,
# e.g. Resend (SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=resend,
# SMTP_PASSWORD=<API key>) once the sender domain is verified. Leave SMTP_HOST empty to keep emails queued.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="InfluencEarn <notifications@influencearn.local>"

# Bearer secret for POST /api/internal/notification-emails (called by a scheduler, e.g. every minute).
# At least 32 characters; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_WORKER_SECRET=

# Header carrying the real client IP for per-IP rate limits (sign-in, sign-up, password reset).
# Default x-forwarded-for (first entry). On Vercel use x-real-ip. Only trust a header your proxy sets.
# TRUSTED_IP_HEADER=x-forwarded-for
